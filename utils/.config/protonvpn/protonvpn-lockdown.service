[Unit]
Description=Persistent VPN-only internet firewall
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /etc/protonvpn-lockdown.nft
ExecReload=/usr/bin/nft -f /etc/protonvpn-lockdown.nft

[Install]
WantedBy=multi-user.target
