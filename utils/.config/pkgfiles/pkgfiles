#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit
export LC_ALL=C

die() {
  : "Report an error and stop."
  printf 'pkgfiles: %s\n' "$*" >&2
  exit 1
}

load_selection() {
  : "Read the deliberate selection used on fresh machines and by Stow."
  local line
  [[ -f $data/configs.txt ]] || die "Missing $data/configs.txt"
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    [[ $line =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ && -d $repo/$line ]] || die "Invalid Stow package: $line"
    [[ ${wanted[$line]:-} ]] && continue
    configs+=("$line")
    wanted[$line]=1
  done < "$data/configs.txt"
  ((${#configs[@]})) || die 'No configs selected in configs.txt'
}

run_command() {
  : "Print shell-escaped commands unless execution was explicitly requested."
  if ((apply)); then
    "$@"
  else
    printf '%q ' "$@"
    printf '\n'
  fi
}

load_apps() {
  : "Select mapped apps by real HOME links, or by the saved config selection."
  local config arch apt probe extra source target linked package
  declare -A seen=()
  [[ -f $data/config-map.tsv ]] || die "Missing $data/config-map.tsv"
  [[ $action != list ]] || printf '%-12s %-12s %s\n' CONFIG PACKAGE LINK
  while read -r config arch apt probe extra; do
    [[ -z $config || $config == \#* ]] && continue
    [[ $config =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ && -z $extra && -n $probe && $probe != /* && /$probe/ != */../* ]] || die 'Invalid config mapping row'
    for package in "$arch" "$apt"; do
      [[ $package == - || $package =~ ^[a-zA-Z0-9][a-zA-Z0-9@._+-]*$ ]] || die "Invalid package name: $package"
    done
    [[ ! ${seen[$config]:-} ]] || die "Duplicate config mapping: $config"
    seen[$config]=1
    linked=unlinked
    if [[ -e $repo/$config/$probe ]]; then
      source=$(realpath -e -- "$repo/$config/$probe")
      target=$(realpath -e -- "$HOME/$probe" 2>/dev/null || true)
      [[ $source != "$target" ]] || linked=linked
    fi
    if ((selected)); then
      [[ ${wanted[$config]:-} ]] || continue
      [[ -e $repo/$config/$probe ]] || die "Missing config probe: $config/$probe"
    else
      [[ $linked == linked ]] || continue
    fi
    package=$arch
    [[ $distro != apt ]] || package=$apt
    if [[ $action == list ]]; then
      printf '%-12s %-12s %s\n' "$config" "$package" "$linked"
    elif [[ $package == - ]]; then
      printf 'pkgfiles: skipping %s (no OS package mapped)\n' "$config" >&2
    else
      apps+=("$package")
    fi
  done < "$data/config-map.tsv"
  for config in "${configs[@]}"; do
    [[ ${seen[$config]:-} ]] || die "No mapping for selected config: $config"
  done
}

resolve_apps() {
  : "Check configured repositories before installing; collect all missing packages."
  local package info line candidate missing=0
  declare -A seen=()
  for package in "${apps[@]}"; do
    [[ ${seen[$package]:-} ]] && continue
    seen[$package]=1
    if [[ $distro == apt ]]; then
      info=$(apt-cache policy "$package") || die "apt-cache query failed: $package"
      candidate=
      while IFS= read -r line; do
        if [[ $line =~ ^[[:space:]]*Candidate:[[:space:]]+([^[:space:]]+) ]]; then
          candidate=${BASH_REMATCH[1]}
        fi
      done <<< "$info"
      if [[ -n $candidate && $candidate != '(none)' ]]; then
        native+=("$package")
        continue
      fi
      printf 'pkgfiles: %s has no APT candidate; check this release and its sources (sudo apt-get update), or omit its config from configs.txt and use --selected.\n' "$package" >&2
    else
      if info=$(pacman -Si -- "$package" 2>&1); then
        native+=("$package")
        continue
      fi
      [[ $info == "error: package '$package' was not found" ]] || die "pacman query failed: $info"
      if command -v yay >/dev/null; then
        if info=$(yay -Si --aur -- "$package" 2>&1); then
          aur+=("$package")
          continue
        fi
        printf 'pkgfiles: yay could not resolve %s: %s\n' "$package" "$info" >&2
      else
        printf 'pkgfiles: %s is absent from pacman repositories; install yay separately to check the AUR.\n' "$package" >&2
      fi
    fi
    missing=1
  done
  ((missing == 0)) || die 'Unresolved packages; no packages were installed.'
}

install_devtools() {
  : "Install user-owned Node/Rust toolchains and distro Go without editing profiles."
  local nvm_dir=${NVM_DIR:-$HOME/.nvm} cargo_home=${CARGO_HOME:-$HOME/.cargo}
  local temp_dir=${TMPDIR:-/tmp}/pkgfiles-devtools.PREVIEW
  if ((apply)); then
    ((EUID != 0)) || die 'Run devtools as a normal user; only OS packages use sudo'
    temp_dir=$(mktemp -d)
    devtools_tmp=$temp_dir
    trap 'rm -rf -- "$devtools_tmp"' EXIT
  else
    printf 'pkgfiles: PREVIEW paths represent temporary downloads; no commands run.\n' >&2
  fi
  if [[ $distro == apt ]]; then
    run_command sudo apt-get update
    run_command sudo apt-get install -- ca-certificates curl git build-essential golang-go
  else
    run_command sudo pacman -Syu --needed -- ca-certificates curl git base-devel go
  fi
  if [[ ! -s $nvm_dir/nvm.sh ]]; then
    run_command curl --fail --show-error --silent --location --proto '=https' --tlsv1.2 \
      https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.7/install.sh -o "$temp_dir/nvm-install.sh"
    run_command env PROFILE=/dev/null NVM_DIR="$nvm_dir" bash "$temp_dir/nvm-install.sh"
  fi
  # shellcheck disable=SC2016 # $NVM_DIR is for the inner bash -c, not this shell.
  run_command env NVM_DIR="$nvm_dir" bash -c \
    'source "$NVM_DIR/nvm.sh" && nvm install node && nvm alias default node'
  if [[ ! -x $cargo_home/bin/rustup ]]; then
    run_command curl --fail --show-error --silent --location --proto '=https' --tlsv1.2 \
      https://sh.rustup.rs -o "$temp_dir/rustup-install.sh"
    run_command env CARGO_HOME="$cargo_home" bash "$temp_dir/rustup-install.sh" \
      -y --no-modify-path --profile default --default-toolchain stable
  fi
  run_command "$cargo_home/bin/rustup" update stable
  run_command "$cargo_home/bin/rustup" default stable
  if ((apply)); then
    rm -rf -- "$temp_dir"
    trap - EXIT
    printf 'pkgfiles: devtools installed. Open a new Bash terminal to load Node and Cargo.\n' >&2
  fi
}

action=list apply=0 selected=0
if [[ $# != 0 && $1 != -* ]]; then action=$1; shift; fi
while (($#)); do
  case $1 in
    --apply) apply=1 ;;
    --selected) selected=1 ;;
    -h|--help) action=help ;;
    *) die "Unexpected argument: $1" ;;
  esac
  shift
done
case $action in
  help)
    printf '%s\n' 'pkgfiles [list] [--selected]' \
      'pkgfiles install [--selected] [--apply]' \
      'pkgfiles stow [--apply]' \
      'pkgfiles devtools [--apply]' \
      'Default scope: configs linked from HOME into this checkout.' \
      '--selected: use packages/configs.txt instead, including on a fresh machine.' \
      'install previews apt-get or pacman/yay commands; --apply executes them.' \
      'stow always uses configs.txt and simulates before applying.' \
      'devtools: NVM/latest Node, stable Rust via rustup, and distro Go (independent of configs).' \
      'compare and restore are aliases for list and install.' \
      'Environment: PKGFILES_REPO, PKGFILES_DISTRO=arch|apt (testing override).'
    exit 0 ;;
  snapshot)
    printf 'pkgfiles: snapshots are retired; disable the old pkgfiles-snapshot.timer. No files changed.\n' >&2
    exit 0 ;;
  compare) action=list ;;
  restore) action=install ;;
  list|install|stow|devtools) ;;
  *) die "Unknown command: $action" ;;
esac
[[ $apply == 0 || $action != list ]] || die '--apply is only valid for install, stow, or devtools'
[[ $selected == 0 || $action != devtools ]] || die 'devtools does not use config selection'
[[ $selected == 0 || $action != stow ]] || die 'stow already uses configs.txt'
script=$(readlink -f -- "${BASH_SOURCE[0]}")
repo=$(realpath -e -- "${PKGFILES_REPO:-${script%/utils/.config/pkgfiles/pkgfiles}}")
data=$repo/packages
configs=() apps=() native=() aur=()
declare -A wanted=()
if ((selected)) || [[ $action == stow ]]; then load_selection; fi
if [[ $action == stow ]]; then
  if ((apply)); then stow --simulate --verbose --dir="$repo" --target="$HOME" "${configs[@]}"; fi
  run_command stow --verbose --dir="$repo" --target="$HOME" "${configs[@]}"
  exit 0
fi

distro=${PKGFILES_DISTRO:-}
if [[ -z $distro ]]; then
  distro_ids=$(bash -c '. /etc/os-release; printf "%s %s" "$ID" "${ID_LIKE:-}"')
  case " $distro_ids " in
    *' arch '*) distro=arch ;;
    *' debian '*|*' ubuntu '*) distro=apt ;;
    *) die "Unsupported distribution: $distro_ids" ;;
  esac
fi
[[ $distro == arch || $distro == apt ]] || die "Unsupported distribution: $distro"
if [[ $action == devtools ]]; then install_devtools; exit 0; fi
load_apps
[[ $action != list ]] || exit 0
((${#apps[@]})) || die 'No mapped apps in scope; use --selected for configs.txt on a fresh machine.'
if [[ $distro == apt && $apply == 1 ]]; then run_command sudo apt-get update; fi
resolve_apps
if [[ $distro == apt ]]; then
  if ((apply == 0)); then run_command sudo apt-get update; fi
  run_command sudo apt-get install -- "${native[@]}"
else
  if ((${#aur[@]} && apply)); then
    ((EUID != 0)) || die 'Run yay installation as a normal user, never root'
  fi
  if ((${#native[@]})); then run_command sudo pacman -Syu --needed -- "${native[@]}"; fi
  if ((${#aur[@]})); then run_command yay -S --needed --aur -- "${aur[@]}"; fi
fi
