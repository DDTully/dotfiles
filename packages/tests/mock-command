#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit

contains() {
  : "Look up an exact package in a whitespace-separated test fixture."
  [[ " $1 " == *" $2 "* ]]
}

tool=${0##*/}
printf '%s ' "$tool" "$@" >> "$FIXTURES/queries"
printf '\n' >> "$FIXTURES/queries"
[[ ${MOCK_FAIL:-} != "$tool" ]] || { printf 'database/command failure\n' >&2; exit 2; }
package=${!#}
case $tool in
  curl)
    output_option=${*: -2:1}
    [[ ${DEVTOOLS_INSTALLER:-} && $output_option == -o ]] || exit 99
    cp "$DEVTOOLS_INSTALLER" "$package" ;;
  pacman)
    [[ $1 == -Si && $2 == -- ]] || exit 99
    if ! contains "${MOCK_NATIVE:-}" "$package"; then
      printf "error: package '%s' was not found\n" "$package" >&2
      exit 1
    fi ;;
  yay)
    if [[ $1 == -Si ]]; then
      [[ $2 == --aur && $3 == -- ]] || exit 99
      contains "${MOCK_AUR:-}" "$package" || { printf 'AUR package not found\n' >&2; exit 1; }
    else
      printf '%s ' "$tool" "$@" >> "$FIXTURES/calls"
      printf '\n' >> "$FIXTURES/calls"
    fi ;;
  apt-cache)
    [[ $1 == policy ]] || exit 99
    if contains "${MOCK_NATIVE:-}" "$package"; then
      printf '%s:\n  Installed: (none)\n  Candidate: 1.0\n' "$package"
    elif [[ ${MOCK_EMPTY:-0} != 1 ]]; then
      printf '%s:\n  Installed: (none)\n  Candidate: (none)\n' "$package"
    fi ;;
  sudo)
    [[ $1 == pacman || $1 == apt-get ]] || exit 99
    printf '%s ' "$tool" "$@" >> "$FIXTURES/calls"
    printf '\n' >> "$FIXTURES/calls"
    [[ ${MOCK_INSTALL_FAIL:-0} != 1 || $2 != install ]] || exit 2 ;;
  *) exit 99 ;;
esac
